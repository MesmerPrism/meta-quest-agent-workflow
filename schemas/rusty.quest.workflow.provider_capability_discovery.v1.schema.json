{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/meta-quest-agent-workflow/schemas/rusty.quest.workflow.provider_capability_discovery.v1.schema.json",
  "$comment": "JSON Schema validation is structural. Consumers must also enforce unique capability/action IDs, observed-at before expiry, exact TimeSpan-tick maximum-age correspondence, the 600-second maximum, current freshness, and executable-vocabulary rejection.",
  "title": "Rusty Quest inert provider capability discovery v1",
  "description": "A short-lived, target-free description of a typed provider surface. It grants no execution, resolves no target, and carries no invocation, endpoint, credential, or coordination data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider",
    "placement",
    "availability",
    "description_authentication",
    "authorizes_execution",
    "target_specific",
    "capabilities",
    "exclusions"
  ],
  "properties": {
    "schema": {
      "const": "rusty.quest.workflow.provider_capability_discovery.v1"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/dottedId"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
        }
      }
    },
    "placement": {
      "enum": [
        "windows-host-process",
        "host-cli",
        "quest-application",
        "managed-service"
      ]
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observed_at_utc",
        "expires_at_utc",
        "maximum_age_seconds"
      ],
      "properties": {
        "status": {
          "enum": [
            "descriptor-available",
            "unavailable",
            "disabled"
          ]
        },
        "observed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "maximum_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "description_authentication": {
      "const": "none"
    },
    "authorizes_execution": {
      "const": false
    },
    "target_specific": {
      "const": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "exclusions": {
      "$ref": "#/$defs/exclusions"
    }
  },
  "$defs": {
    "dottedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._-]+[a-z0-9]$"
    },
    "contractId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 192,
      "pattern": "^[a-z0-9][a-z0-9._-]+[a-z0-9]$"
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9.-]+[a-z0-9]$"
      }
    },
    "authenticationRequirement": {
      "enum": [
        "none",
        "process-access-control",
        "caller-authority-external",
        "exact-target-binding",
        "current-identity-revision",
        "effect-owner-profile",
        "owner-session-grant",
        "wearer-approval",
        "ownership-generation"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "authentication_requirements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+[A-Za-z0-9]$"
        },
        "kind": {
          "enum": [
            "observe",
            "effect",
            "cleanup"
          ]
        },
        "authentication_requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/authenticationRequirement"
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contract_versions",
        "actions",
        "effect_owner",
        "receipt_schema",
        "exclusions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/dottedId"
        },
        "contract_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contractId"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "effect_owner": {
          "$ref": "#/$defs/dottedId"
        },
        "receipt_schema": {
          "$ref": "#/$defs/contractId"
        },
        "exclusions": {
          "$ref": "#/$defs/exclusions"
        }
      }
    }
  }
}
